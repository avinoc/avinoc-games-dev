---
import GameLayout from "../../../layouts/GameLayout.astro";
const base = import.meta.env.BASE_URL;

interface BuildCard {
  id: string;
  team: string;
  buildNum: string;
  title: string;
  description: string;
  score: number;
  saveDate: string;
  cardCount: number;
  faintMemory: number;
  copies: number;
  removes: number;
  cards: { name: string; count: number }[];
  image: string;
}

const builds: BuildCard[] = [
  {
    id: "team-1-build-1",
    team: "Team 1",
    buildNum: "01",
    title: "Ironclad Counterblade loop",
    description: "The highest-scoring opener on Team 1, anchored by Hew (Ironclad), Fighting Spirit, and double Spore Harvester copies.",
    score: 66390,
    saveDate: "26.02.17",
    cardCount: 8,
    faintMemory: 180,
    copies: 3,
    removes: 4,
    cards: [
      { name: "Hew (Ironclad)", count: 1 },
      { name: "Fatal Strike", count: 1 },
      { name: "Counterblade", count: 1 },
      { name: "Fighting Spirit", count: 2 },
      { name: "Spore Harvester", count: 2 },
    ],
    image: "/assets/chaoszero/builds/team-1-build-1.png",
  },
  {
    id: "team-1-build-2",
    team: "Team 1",
    buildNum: "02",
    title: "Darkness sustain stack",
    description: "A compact sustain build that leans on repeated Snack Time copies with darkness scaling and one burst opener.",
    score: 63770,
    saveDate: "26.02.21",
    cardCount: 6,
    faintMemory: 180,
    copies: 3,
    removes: 5,
    cards: [
      { name: "Strike of Darkness", count: 1 },
      { name: "Resonating Darkness", count: 1 },
      { name: "Snack Time", count: 4 },
    ],
    image: "/assets/chaoszero/builds/team-1-build-2.png",
  },
  {
    id: "team-1-build-3",
    team: "Team 1",
    buildNum: "03",
    title: "Repose utility shell",
    description: "The leanest Team 1 list. Triple Repose keeps the hand moving while Pendant of Resolution and Sir Kowalski set timing.",
    score: 63910,
    saveDate: "26.03.06",
    cardCount: 5,
    faintMemory: 180,
    copies: 2,
    removes: 5,
    cards: [
      { name: "Repose", count: 3 },
      { name: "Pendant of Resolution", count: 1 },
      { name: "Sir Kowalski", count: 1 },
    ],
    image: "/assets/chaoszero/builds/team-1-build-3.png",
  },
  {
    id: "team-2-build-1",
    team: "Team 2",
    buildNum: "01",
    title: "Chrono flame setup",
    description: "Chronicle-based setup that turns into triple Flame of Eternity scaling for the second team's control lane.",
    score: 59450,
    saveDate: "26.03.25",
    cardCount: 7,
    faintMemory: 150,
    copies: 2,
    removes: 4,
    cards: [
      { name: "Chrono Archon", count: 1 },
      { name: "Time Axis Collapse", count: 1 },
      { name: "Chrono Circle", count: 1 },
      { name: "Time Paradox", count: 1 },
      { name: "Flame of Eternity", count: 3 },
    ],
    image: "/assets/chaoszero/builds/team-2-build-1.png",
  },
  {
    id: "team-2-build-2",
    team: "Team 2",
    buildNum: "02",
    title: "Quantum Seed creation core",
    description: "The highest individual score in the screenshot pack. It runs triple Quantum Seed with Dual Creation and double Reorganize.",
    score: 70360,
    saveDate: "26.03.29",
    cardCount: 7,
    faintMemory: 180,
    copies: 2,
    removes: 5,
    cards: [
      { name: "Quantum Seed", count: 3 },
      { name: "Dual Creation", count: 1 },
      { name: "Event Horizon", count: 1 },
      { name: "Reorganize", count: 2 },
    ],
    image: "/assets/chaoszero/builds/team-2-build-2.png",
  },
  {
    id: "team-2-build-3",
    team: "Team 2",
    buildNum: "03",
    title: "Source of Water sustain engine",
    description: "A six-card wave sustain list using four Source of Water copies with Tactical Analysis and Deluge to round the line out.",
    score: 64280,
    saveDate: "26.03.24",
    cardCount: 6,
    faintMemory: 180,
    copies: 3,
    removes: 5,
    cards: [
      { name: "Source of Water", count: 4 },
      { name: "Tactical Analysis", count: 1 },
      { name: "Deluge", count: 1 },
    ],
    image: "/assets/chaoszero/builds/team-2-build-3.png",
  },
];

const team1Total = builds.filter((b) => b.team === "Team 1").reduce((sum, b) => sum + b.score, 0);
const team2Total = builds.filter((b) => b.team === "Team 2").reduce((sum, b) => sum + b.score, 0);
const combinedTotal = team1Total + team2Total;
---

<GameLayout
  title="Event Scores | Chaos Zero Nightmare"
  description="Screenshot-driven Great Rift top-score build viewer for Chaos Zero Nightmare."
  game="chaoszero"
>
  <section class="cz-page">
    <div class="cz-page__noise" aria-hidden="true"></div>

    <section class="container cz-overview">
      <a class="cz-back-link" href={`${base}chaoszero/`}>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round">
          <path d="m15 18-6-6 6-6" />
        </svg>
        Chaos Zero hub
      </a>
      <p class="cz-kicker">Great Rift top-score viewer</p>
      <h1>Great Rift Top Score Build Pack</h1>
      <p class="cz-overview__summary">
        Imported from six build screenshots. Select any build below to inspect the original sheet,
        card counts, and team totals without placeholder event data.
      </p>
      <div class="cz-overview__totals">
        <div class="cz-total-pill">
          <span>Team 1</span>
          <strong>{team1Total.toLocaleString()} TB</strong>
        </div>
        <div class="cz-total-pill">
          <span>Team 2</span>
          <strong>{team2Total.toLocaleString()} TB</strong>
        </div>
        <div class="cz-total-pill cz-total-pill--combined">
          <span>Combined</span>
          <strong>{combinedTotal.toLocaleString()} TB</strong>
        </div>
      </div>
    </section>

    <section class="container cz-top-grid">
      <div class="cz-feature-stack">
        {builds.map((build) => (
          <article class="cz-feature-card" data-feature-card data-build-id={build.id} aria-hidden="true">
            <div class="cz-feature-card__copy">
              <div class="cz-feature-card__meta">
                <span>{build.team}</span>
                <span>Build {build.buildNum}</span>
              </div>
              <h2>{build.title}</h2>
              <p>{build.description}</p>
              <div class="cz-score-pill">{build.score.toLocaleString()} TB</div>
              <div class="cz-stat-grid">
                <div><span>Save date</span><strong>{build.saveDate}</strong></div>
                <div><span>Card count</span><strong>{build.cardCount}</strong></div>
                <div><span>Faint memory</span><strong>{build.faintMemory} pts</strong></div>
                <div><span>Copy / Remove</span><strong>{build.copies} / {build.removes}</strong></div>
              </div>
              <div class="cz-card-chip-row">
                {build.cards.map((card) => (
                  <span class="cz-card-chip">{card.count > 1 ? `${card.name} ×${card.count}` : card.name}</span>
                ))}
              </div>
            </div>
            <div class="cz-feature-card__media">
              <img src={build.image} alt={`${build.team} Build ${build.buildNum} screenshot`} width="1024" height="768" loading="lazy" />
            </div>
          </article>
        ))}
      </div>

      <aside class="cz-side-stack">
        <div class="cz-side-card">
          <span class="cz-side-card__label">Top single build</span>
          <strong>Team 2 Build 02</strong>
          <p>Quantum Seed creation core</p>
          <div class="cz-score-pill">70,360 TB</div>
        </div>
        <div class="cz-side-card">
          <span class="cz-side-card__label">Most repeated stacks</span>
          <div class="cz-card-chip-row">
            <span class="cz-card-chip">Snack Time ×4</span>
            <span class="cz-card-chip">Source of Water ×4</span>
            <span class="cz-card-chip">Flame of Eternity ×3</span>
            <span class="cz-card-chip">Quantum Seed ×3</span>
          </div>
        </div>
      </aside>
    </section>

    <section class="container cz-panels">
      <article class="cz-panel">
        <div class="cz-panel__header">
          <div>
            <span class="cz-kicker">Current Meta Breakdown</span>
            <h2>Build selector</h2>
          </div>
        </div>
        <div class="cz-selector-groups">
          {["Team 1", "Team 2"].map((team) => {
            const teamBuilds = builds.filter((b) => b.team === team);
            const teamTotal = teamBuilds.reduce((sum, b) => sum + b.score, 0);
            return (
              <section class="cz-selector-group">
                <header class="cz-selector-group__header">
                  <div>
                    <span>{team}</span>
                    <p>
                      {team === "Team 1"
                        ? "Burst-first opener group from the current top Great Rift clear. This side handles the front-loaded damage lane."
                        : "Longer-cycle control and creation side from the same top run. This team closes with sustain, scaling, and card creation."}
                    </p>
                  </div>
                  <strong>{teamTotal.toLocaleString()} TB</strong>
                </header>
                <div class="cz-selector-list">
                  {teamBuilds.map((build) => (
                    <button
                      class="cz-selector-button"
                      data-build-button
                      data-build-id={build.id}
                      id={build.id}
                      type="button"
                      aria-pressed="false"
                    >
                      <img src={build.image} alt="" width="256" height="144" loading="lazy" />
                      <div class="cz-selector-button__body">
                        <div class="cz-selector-button__top">
                          <strong>Build {build.buildNum}</strong>
                          <span>{build.score.toLocaleString()} TB</span>
                        </div>
                        <h3>{build.title}</h3>
                        <p>{build.saveDate} · {build.cardCount} cards · {build.faintMemory} FM</p>
                        <div class="cz-card-chip-row">
                          {build.cards.map((card) => (
                            <span class="cz-card-chip">{card.count > 1 ? `${card.name} ×${card.count}` : card.name}</span>
                          ))}
                        </div>
                      </div>
                    </button>
                  ))}
                </div>
              </section>
            );
          })}
        </div>
      </article>

      <article class="cz-panel">
        <div class="cz-panel__header">
          <div>
            <span class="cz-kicker">Imported Build Sheet</span>
            <h2>Original screenshot and parsed data</h2>
          </div>
        </div>
        <div class="cz-sheet-stack">
          {builds.map((build) => (
            <article class="cz-sheet" data-build-sheet data-build-id={build.id} aria-hidden="true">
              <div class="cz-sheet__image">
                <img src={build.image} alt={`${build.team} Build ${build.buildNum} full build screenshot`} width="1024" height="768" loading="lazy" />
              </div>
              <div class="cz-sheet__meta">
                <div class="cz-sheet__heading">
                  <span>{build.team} · Build {build.buildNum}</span>
                  <h3>{build.title}</h3>
                  <p>{build.description}</p>
                </div>
                <div class="cz-sheet__stats">
                  <div><span>Score</span><strong>{build.score.toLocaleString()} TB</strong></div>
                  <div><span>Save date</span><strong>{build.saveDate}</strong></div>
                  <div><span>Card count</span><strong>{build.cardCount}</strong></div>
                  <div><span>Faint memory</span><strong>{build.faintMemory}</strong></div>
                  <div><span>Copy</span><strong>{build.copies}</strong></div>
                  <div><span>Remove</span><strong>{build.removes}</strong></div>
                </div>
                <div class="cz-sheet__cards">
                  {build.cards.map((card) => (
                    <div class="cz-sheet-card">
                      <strong>{card.name}</strong>
                      <span>{card.count} {card.count === 1 ? "copy" : "copies"}</span>
                    </div>
                  ))}
                </div>
              </div>
            </article>
          ))}
        </div>
      </article>
    </section>
  </section>
</GameLayout>

<script>
  const defaultBuildId = "team-2-build-2";

  const buttons = Array.from(document.querySelectorAll("[data-build-button]"));
  const featureCards = Array.from(document.querySelectorAll("[data-feature-card]"));
  const sheets = Array.from(document.querySelectorAll("[data-build-sheet]"));

  function activateBuild(id: string) {
    buttons.forEach((button) => {
      const active = (button as HTMLElement).dataset.buildId === id;
      (button as HTMLElement).classList.toggle("is-active", active);
      (button as HTMLElement).setAttribute("aria-pressed", active ? "true" : "false");
    });

    featureCards.forEach((card) => {
      const active = (card as HTMLElement).dataset.buildId === id;
      (card as HTMLElement).classList.toggle("is-active", active);
      (card as HTMLElement).setAttribute("aria-hidden", active ? "false" : "true");
    });

    sheets.forEach((sheet) => {
      const active = (sheet as HTMLElement).dataset.buildId === id;
      (sheet as HTMLElement).classList.toggle("is-active", active);
      (sheet as HTMLElement).setAttribute("aria-hidden", active ? "false" : "true");
    });

    if (history.replaceState) {
      history.replaceState(null, "", `#${id}`);
    }
  }

  const initialId = window.location.hash.slice(1);
  const hasInitialBuild = initialId && buttons.some((button) => (button as HTMLElement).dataset.buildId === initialId);
  activateBuild(hasInitialBuild ? initialId : defaultBuildId);

  buttons.forEach((button) => {
    button.addEventListener("click", () => {
      const id = (button as HTMLElement).dataset.buildId;
      if (id) activateBuild(id);
    });
  });

  window.addEventListener("hashchange", () => {
    const nextId = window.location.hash.slice(1);
    if (nextId && buttons.some((button) => (button as HTMLElement).dataset.buildId === nextId)) {
      activateBuild(nextId);
    }
  });
</script>

<style>
  .cz-page {
    position: relative;
    min-height: 100vh;
    padding-bottom: 4rem;
  }

  .cz-page__noise {
    position: fixed;
    inset: 0;
    pointer-events: none;
    opacity: 0.035;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)'/%3E%3C/svg%3E");
  }

  .cz-back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--text-soft);
    text-decoration: none;
    font-size: 0.85rem;
    margin-bottom: 0.75rem;
    transition: color 150ms ease;
  }

  .cz-back-link:hover {
    color: var(--accent);
  }

  .cz-kicker {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent);
    font-weight: 600;
    margin-bottom: 0.5rem;
  }

  .cz-overview h1 {
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    font-weight: 800;
    line-height: 1.15;
    margin-bottom: 0.75rem;
    color: var(--ink);
  }

  .cz-overview__summary {
    max-width: 640px;
    color: var(--text-soft);
    font-size: 1.05rem;
    line-height: 1.6;
    margin-bottom: 1.5rem;
  }

  .cz-overview__totals {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .cz-total-pill {
    display: inline-flex;
    flex-direction: column;
    padding: 0.6rem 1.2rem;
    border-radius: 999px;
    background: var(--surface-2);
    border: 1px solid var(--line);
    gap: 0.15rem;
  }

  .cz-total-pill span {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-soft);
  }

  .cz-total-pill strong {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--ink);
  }

  .cz-total-pill--combined {
    background: linear-gradient(135deg, rgba(168, 85, 247, 0.12), rgba(192, 132, 252, 0.08));
    border-color: rgba(168, 85, 247, 0.25);
  }

  .cz-top-grid {
    display: grid;
    grid-template-columns: 1fr 280px;
    gap: 1.5rem;
    margin-top: 2rem;
  }

  @media (max-width: 900px) {
    .cz-top-grid {
      grid-template-columns: 1fr;
    }
  }

  .cz-feature-stack {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .cz-feature-card {
    display: grid;
    grid-template-columns: 1fr 320px;
    gap: 1.25rem;
    padding: 1.5rem;
    border-radius: var(--radius-lg, 20px);
    background: var(--surface-2);
    border: 1px solid var(--line);
    transition: border-color 200ms ease, box-shadow 200ms ease;
  }

  .cz-feature-card:not(.is-active) {
    display: none;
  }

  .cz-feature-card.is-active {
    display: grid;
  }

  @media (max-width: 768px) {
    .cz-feature-card.is-active {
      grid-template-columns: 1fr;
    }
  }

  .cz-feature-card__copy {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .cz-feature-card__meta {
    display: flex;
    gap: 0.5rem;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-soft);
  }

  .cz-feature-card__copy h2 {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--ink);
    margin: 0;
  }

  .cz-feature-card__copy p {
    color: var(--text-soft);
    font-size: 0.92rem;
    line-height: 1.55;
    margin: 0;
  }

  .cz-score-pill {
    display: inline-flex;
    padding: 0.35rem 0.85rem;
    border-radius: 999px;
    background: linear-gradient(135deg, rgba(168, 85, 247, 0.15), rgba(192, 132, 252, 0.1));
    border: 1px solid rgba(168, 85, 247, 0.25);
    font-weight: 700;
    font-size: 0.95rem;
    color: var(--accent);
    width: fit-content;
  }

  .cz-stat-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(100px, 1fr));
    gap: 0.5rem;
  }

  .cz-stat-grid div {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }

  .cz-stat-grid div span {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-soft);
  }

  .cz-stat-grid div strong {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--ink);
  }

  .cz-card-chip-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .cz-card-chip {
    display: inline-flex;
    padding: 0.25rem 0.6rem;
    border-radius: 999px;
    background: var(--surface-3);
    border: 1px solid var(--line);
    font-size: 0.78rem;
    color: var(--text);
    font-weight: 500;
  }

  .cz-feature-card__media {
    border-radius: 12px;
    overflow: hidden;
    background: var(--surface-3);
  }

  .cz-feature-card__media img {
    width: 100%;
    height: auto;
    display: block;
  }

  .cz-side-stack {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .cz-side-card {
    padding: 1.25rem;
    border-radius: var(--radius-lg, 20px);
    background: var(--surface-2);
    border: 1px solid var(--line);
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .cz-side-card__label {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-soft);
  }

  .cz-side-card strong {
    font-size: 1rem;
    font-weight: 700;
    color: var(--ink);
  }

  .cz-side-card p {
    font-size: 0.85rem;
    color: var(--text-soft);
    margin: 0;
  }

  .cz-panels {
    margin-top: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .cz-panel {
    padding: 1.5rem;
    border-radius: var(--radius-lg, 20px);
    background: var(--surface-2);
    border: 1px solid var(--line);
  }

  .cz-panel__header {
    margin-bottom: 1.25rem;
  }

  .cz-panel__header h2 {
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--ink);
    margin: 0.25rem 0 0;
  }

  .cz-selector-groups {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
    gap: 1.25rem;
  }

  .cz-selector-group {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .cz-selector-group__header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--line);
  }

  .cz-selector-group__header > div span {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .cz-selector-group__header > div p {
    font-size: 0.82rem;
    color: var(--text-soft);
    margin: 0.25rem 0 0;
    line-height: 1.45;
  }

  .cz-selector-group__header strong {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--ink);
    white-space: nowrap;
  }

  .cz-selector-list {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .cz-selector-button {
    display: grid;
    grid-template-columns: 120px 1fr;
    gap: 0.75rem;
    padding: 0.75rem;
    border-radius: 12px;
    border: 1px solid var(--line);
    background: var(--surface-3);
    cursor: pointer;
    transition: border-color 200ms ease, background 200ms ease, box-shadow 200ms ease;
    text-align: left;
    color: inherit;
  }

  .cz-selector-button:hover {
    border-color: rgba(168, 85, 247, 0.3);
    background: var(--surface-2);
  }

  .cz-selector-button.is-active {
    border-color: rgba(168, 85, 247, 0.4);
    background: linear-gradient(135deg, rgba(168, 85, 247, 0.08), transparent);
    box-shadow: 0 0 0 1px rgba(168, 85, 247, 0.15);
  }

  .cz-selector-button img {
    width: 100%;
    height: 68px;
    object-fit: cover;
    border-radius: 8px;
    background: var(--surface-1);
  }

  .cz-selector-button__body {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    min-width: 0;
  }

  .cz-selector-button__top {
    display: flex;
    justify-content: space-between;
