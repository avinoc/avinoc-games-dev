---
import GameLayout from "../../layouts/GameLayout.astro";
const base = import.meta.env.BASE_URL;
---

<GameLayout
  title="Chaos Zero Nightmare"
  description="Great Rift domination hub with imported screenshot builds, card overlap, and tactical breakdowns."
  game="chaoszero"
>
  <section class="hero">
    <div class="container">
      <div class="hero-wrap">
        <p class="eyebrow">Chaos Zero Nightmare Hub</p>
        <h1>Great Rift domination, tracked and shared.</h1>
        <p>
          Import your screenshot builds, compare card overlap with your guild, and browse tactical
          breakdowns for the current event. All build data is community-sourced and updated in real time.
        </p>
        <div class="hero-actions">
          <a class="button primary" href={`${base}chaoszero/event-scores/`}>View Event Scores</a>
          <a class="button secondary" href={`${base}chaoszero/builds/`}>Browse Builds</a>
        </div>
      </div>
    </div>
  </section>

  <section class="container stack">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Quick Access</p>
        <h2>Jump to a section</h2>
      </div>
    </div>

    <div class="card-grid">
      <a class="content-card" href={`${base}chaoszero/event-scores/`} style="text-decoration: none;">
        <h3>Event Scores</h3>
        <p>Live event countdown, combined TB scores, and build datalists for the current Great Rift.</p>
      </a>
      <a class="content-card" href={`${base}chaoszero/builds/`} style="text-decoration: none;">
        <h3>Build Database</h3>
        <p>Character build cards with team assignments, card counts, and score breakdowns.</p>
      </a>
      <a class="content-card" href={`${base}chaoszero/card-overlap/`} style="text-decoration: none;">
        <h3>Card Overlap</h3>
        <p>Compare card overlap between builds to optimize shared resources across your teams.</p>
      </a>
    </div>
  </section>
</GameLayout>
